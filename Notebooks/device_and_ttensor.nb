Cell[TextData[{
 Cell["TTerm", "InlineCode",ExpressionUUID->
  "080b48c7-cfce-4107-b88e-b060980f818e"],
 " is for interaction net primitives (lambda, application, superposition). ",
 Cell["TTensor", "InlineCode",ExpressionUUID->
  "bc42e558-6b02-4425-b625-bc8e79b36e60"],
 " is for tensor operations. They interoperate via ",
 Cell["ToTTerm", "InlineCode",ExpressionUUID->
  "6dde499b-90fc-4fd5-b213-5d2415062965"],
 "/",
 Cell["ToTTensor", "InlineCode",ExpressionUUID->
