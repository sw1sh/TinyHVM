Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"t", "[", 
  RowBox[{"[", "\"\<View\>\"", "]"}], "]"}]], "Input",ExpressionUUID->\
"6e933811-a848-4986-bd5f-143450260c47"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Shape\"\>", "\[Rule]", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"$Failed", "[", "1", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"2", ";;", "2"}], "\[RightDoubleBracket]"}], "]"}]}], ",", 
   RowBox[{"\<\"Strides\"\>", "\[Rule]", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"$Failed", "[", "1", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"3", ";;", "3"}], "\[RightDoubleBracket]"}], "]"}]}], ",", 
   RowBox[{"\<\"Offset\"\>", "\[Rule]", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"$Failed", "[", "1", "]"}], "\[LeftDoubleBracket]", "4", 
      "\[RightDoubleBracket]"}], "]"}]}], ",", 
   RowBox[{"\<\"NumEl\"\>", "\[Rule]", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"$Failed", "[", "1", "]"}], "\[LeftDoubleBracket]", "5", 
      "\[RightDoubleBracket]"}], "]"}]}], ",", 
   RowBox[{"\<\"Contiguous\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"$Failed", "[", "1", "]"}], "\[LeftDoubleBracket]", "6", 
      "\[RightDoubleBracket]"}], ">", "0.5`"}]}], ",", 
   RowBox[{"\<\"HasMask\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"$Failed", "[", "1", "]"}], "\[LeftDoubleBracket]", "7", 
      "\[RightDoubleBracket]"}], ">", "0.5`"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]=",ExpressionUUID->"2345baea-5eeb-4b00-9681-4eab930b0ba2"]
}, Open  ]],

