Cell[CellGroupData[{
Cell["TTensor, Devices & Interactive Reduction", "Title",ExpressionUUID->"5799c74d-b387-466d-bd74-05ae712ded81"],

Cell[TextData[{
 "This notebook demonstrates the TinyHVM v2 API: per-tensor device tracking, \
the ",
 Cell["TTensor", "InlineCode",ExpressionUUID->
  "7883d256-ccb1-4bcb-9099-a29074d3c8dc"],
 " head with rich property access, interaction net graph visualization from \
the C heap, and single-step reduction for interactive debugging."
}], "Text",ExpressionUUID->"f9def5be-85fa-424b-a022-f58266ede614"],

