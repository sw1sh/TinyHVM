Notebook[{
Cell["TTensor, Devices & IC-Native Reduction", "Title",ExpressionUUID->"2decebbe-b276-4c0d-aaf6-a0ef035a8c6b"],

Cell[TextData[{
 "This notebook demonstrates the TinyHVM v2 API: per-tensor device tracking, \
the ",
 Cell["TTensor", "InlineCode",ExpressionUUID->
  "dbf0d254-c9e1-4650-94ff-7c1e020653f8"],
 " head, interaction net graph visualization from the C heap \[LongDash] \
including DUP/SUP sharing nodes \[LongDash] and single-step reduction for \
interactive debugging."
}], "Text",ExpressionUUID->"d600e0ed-c33c-48b1-89a4-c073fdc320e3"],

Cell["Setup", "Chapter",ExpressionUUID->"627d70dc-605b-43e8-afea-8db8aa32efcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PacletDirectoryLoad", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<..\>\"", ",", 
      " ", "\"\<wl\>\""}], "}"}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{"Get", "[", "\"\<TinyHVM`\>\"", "]"}]}], "Input",ExpressionUUID->\
"237cc530-b3b4-42e7-b3eb-687db1cd1f84"],

Cell["Initialize with Metal GPU backend:", "Text",ExpressionUUID->"e62477ff-ec1d-4d23-8f83-51b1bbfa5d97"],

Cell[BoxData[
 RowBox[{"TInit", "[", "\"\<metal\>\"", "]"}]], "Input",ExpressionUUID->"f7b20626-461a-42bb-8432-f28af27b17c9"],

Cell["TTensor Basics", "Chapter",ExpressionUUID->"9ebed301-9208-4c86-8411-549ce76123d4"],

Cell[TextData[{
 Cell["TCreate", "InlineCode",ExpressionUUID->
  "4e0a3e41-4c6d-432f-b76f-9f85bfb2b3c6"],
 " returns ",
 Cell["TTensor", "InlineCode",ExpressionUUID->
  "415335f6-2d4f-4327-944c-77d3892da31a"],
 " (not ",
 Cell["TTerm", "InlineCode",ExpressionUUID->
  "dc24c30b-c9a2-419b-9f85-747564e03be1"],
 "). Tensors carry shape, device, and view metadata:"
}], "Text",ExpressionUUID->"93fe2053-fd86-4846-885f-b6fad0379bf8"],

Cell[BoxData[
 RowBox[{"t", " ", "=", " ", 
  RowBox[{"TCreate", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "2.", ",", " ", "3."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4.", ",", " ", "5.", ",", " ", "6."}], "}"}]}], "}"}], 
   "]"}]}]], "Input",ExpressionUUID->"6ea73650-c9e6-4357-b4a6-c252b6a6eb63"],

Cell["Property access via SubValues:", "Text",ExpressionUUID->"0d1d7798-3b6e-406b-9dba-568625d10bb4"],

Cell[BoxData[{
 RowBox[{"t", "[", "\"\<Shape\>\"", "]"}], "\n", 
 RowBox[{"t", "[", "\"\<Device\>\"", "]"}], "\n", 
 RowBox[{"t", "[", "\"\<View\>\"", "]"}]}], "Input",ExpressionUUID->"0a686594-\
3ec9-4f18-8c0a-afa71ae7d027"],

Cell["Lazy vs Materialized", "Chapter",ExpressionUUID->"8e8ca644-381e-4cf3-ba9a-2ab66c68150a"],

Cell[TextData[{
 "Operations produce lazy ",
 Cell["TTensor", "InlineCode",ExpressionUUID->
  "027d49b4-589a-4740-a3d2-22a7b413d25c"],
 " nodes until reduced:"
}], "Text",ExpressionUUID->"46b6c6aa-b63e-4ca6-abf6-34563d9b0753"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"u", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10.", ",", " ", "20.", ",", " ", "30."}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"40.", ",", " ", "50.", ",", " ", "60."}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"lazy", " ", "=", " ", 
  RowBox[{
   RowBox[{"TOp", "[", "\"\<Add\>\"", "]"}], "[", 
   RowBox[{"t", ",", " ", "u"}], "]"}]}]}], "Input",ExpressionUUID->"32065462-\
5175-4ce6-a9ad-76bd0194ab9a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"lazy", "[", "\"\<Lazy\>\"", "]"}], ",", " ", 
   RowBox[{"lazy", "[", "\"\<Op\>\"", "]"}]}], "}"}]], "Input",ExpressionUUID->\
"38b5ad09-a790-4c2f-818a-a41016453e62"],

Cell["After reduction, the tensor is materialized:", "Text",ExpressionUUID->"1f2b2a30-ba3f-41be-85b4-43677e6c0a3d"],

Cell[BoxData[{
 RowBox[{"mat", " ", "=", " ", 
  RowBox[{"TReduce", "[", "lazy", "]"}]}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", "mat", "]"}], "]"}]}], "Input",ExpressionUUID->\
"3aafc0bd-c881-499f-af5f-c273ac6e22e0"],

Cell["Natural Arithmetic", "Chapter",ExpressionUUID->"a5d74525-679f-4717-a6c2-0a2f8530b925"],

Cell["\<\
TTensor supports natural Wolfram Language syntax via UpValues:\
\>", "Text",ExpressionUUID->"330d165b-cc98-4793-b7e6-1a1d9da320fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1.", ",", " ", "2."}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3.", ",", " ", "4."}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10.", ",", " ", "20."}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"30.", ",", " ", "40."}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", 
   RowBox[{"TReduce", "[", 
    RowBox[{"a", " ", "+", " ", "b"}], "]"}], "]"}], "]"}]}], "Input",Expressi\
onUUID->"4544c324-1aff-451a-80eb-2c7d20b7a955"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", 
   RowBox[{"TReduce", "[", 
    RowBox[{"a", " ", "-", " ", "b"}], "]"}], "]"}], "]"}]], "Input",Expressio\
nUUID->"ac89832a-f2d6-4b08-bd5a-b048060d0747"],

Cell[TextData[{
 "Matrix multiplication via ",
 Cell["Dot", "InlineCode",ExpressionUUID->
  "f08851f4-1b0d-4c07-bcc8-84147e09c94f"],
 ":"
}], "Text",ExpressionUUID->"1c2fcaca-c204-492d-8815-d0b5c39ed231"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", 
   RowBox[{"TReduce", "[", 
    RowBox[{"a", " ", ".", " ", "b"}], "]"}], "]"}], "]"}]], "Input",Expressio\
nUUID->"18aa1622-8f0a-4ff2-be5a-03d243241ca0"],

Cell["Unary operations:", "Text",ExpressionUUID->"5918cfa6-37d3-4027-b12d-ae959fbe4817"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", 
   RowBox[{"TReduce", "[", 
    RowBox[{"Sqrt", "[", "a", "]"}], "]"}], "]"}], "]"}]], "Input",ExpressionU\
UID->"0619d707-a213-4ae7-9763-c6de1f9fcaf2"],

Cell["Device Queries", "Chapter",ExpressionUUID->"d81bddb2-9390-447d-a3a3-0ca67298ed7c"],

Cell["Every tensor knows which device it lives on:", "Text",ExpressionUUID->"e03dec74-0049-45d5-9e82-e65bdaa463c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gpu", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "2.", ",", " ", "3."}], "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TDevice", "[", "gpu", "]"}]}], "Input",ExpressionUUID->"c0d05112-\
3f5c-4bb8-94f5-ad9aa577f7a4"],

Cell["Interaction Net Graph \[LongDash] DUP Sharing", "Chapter",ExpressionUUID->"01006e22-e85e-46e7-85ce-4690eab613c3"],

Cell[TextData[{
 Cell["TINetGraph", "InlineCode",ExpressionUUID->
  "0ffa4575-8d6d-4d6a-ae5d-811b343d43a9"],
 " walks the C heap and renders the actual interaction net. When a tensor is \
used in multiple positions, ",
 Cell["linear_use", "InlineCode",ExpressionUUID->
  "56e9e159-08d2-4a85-9125-e22ded25be52"],
 " creates a ",
 StyleBox["DUP node",
  FontWeight->Bold],
 " (1-slot sharing) with two projections: DP0 and DP1 (orange in the graph)."
}], "Text",ExpressionUUID->"ba1efad6-8981-4a9c-a5b9-e96a582e63e0"],

Cell["Simple chain (no sharing)", "Section",ExpressionUUID->"b7bff13b-04c4-40a5-9ddd-77e4a33246ad"],

Cell["Two distinct inputs \[LongDash] no DUP nodes appear:", "Text",ExpressionUUID->"99f4259d-33db-4f47-bf3b-67dea47a588e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "2."}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3.", ",", " ", "4."}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simple", " ", "=", " ", 
   RowBox[{
    RowBox[{"TOp", "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{"x", ",", " ", "y"}], "]"}]}], ";"}], "\n", 
 RowBox[{"TINetGraph", "[", "simple", "]"}]}], "Input",ExpressionUUID->\
"76471a4d-fb87-4731-8fac-083136fe8031"],

Cell["Shared input \[LongDash] DUP appears", "Section",ExpressionUUID->"3b2be471-b9fa-4f33-8961-0f86744adbd9"],

Cell[TextData[{
 "Using ",
 Cell["x", "InlineCode",ExpressionUUID->
  "f407642e-c72a-4181-8cd9-68c108024bee"],
 " in ",
 StyleBox["both",
  FontWeight->Bold],
 " positions of a binary op triggers ",
 Cell["linear_use", "InlineCode",ExpressionUUID->
  "7d2d0b90-8b98-4fed-8b5e-3f4448ec81cb"],
 ". The graph renders DUP as a single orange node with ",
 StyleBox["dp0",
  FontWeight->Bold],
 "/",
 StyleBox["dp1",
  FontWeight->Bold],
 " edge labels showing which port each parent connects through:"
}], "Text",ExpressionUUID->"49e61092-0a22-4b6f-b2b6-2aed9563b809"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2.", ",", " ", "3."}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xSquared", " ", "=", " ", 
   RowBox[{
    RowBox[{"TOp", "[", "\"\<Mul\>\"", "]"}], "[", 
    RowBox[{"x", ",", " ", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{"TINetGraph", "[", 
  RowBox[{"xSquared", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], "Input",Expressi\
onUUID->"32b9bc0b-bff2-4040-8f40-dfb1e093ebdb"],

Cell["The graph shows:", "Text",ExpressionUUID->"23b12133-116b-4b71-ae0f-657604a0b28f"],

Cell[TextData[{
 StyleBox["Mul",
  FontWeight->Bold],
 " at the root with two edges to a single ",
 StyleBox["Dup",
  FontWeight->Bold],
 " node \[LongDash] labeled dp0 and dp1"
}], "Item",ExpressionUUID->"f9ad7f76-b526-4c72-b25c-59504b4e1006"],

Cell[TextData[{
 "The Dup node points to the shared ",
 StyleBox["TEN",
  FontWeight->Bold],
 " leaf (the ",
 Cell["x", "InlineCode",ExpressionUUID->
  "c21896d8-01a7-4582-85cc-869a913d231b"],
 " tensor)"
}], "Item",ExpressionUUID->"673f6261-32ee-4512-bd94-509ca8e05cfb"],

Cell["Deeper sharing \[LongDash] DUP through a chain", "Section",ExpressionUUID->"adbef804-5583-4343-a35d-d83ad3e7ad05"],

Cell["\<\
When a shared tensor feeds through intermediate ops, the DUP node appears at \
the fan-out point:\
\>", "Text",ExpressionUUID->"5f54ccba-a9a3-49c4-844f-b2aa05147d52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", " ", "=", " ", 
    RowBox[{"TCreate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1.", ",", " ", "2.", ",", " ", "3.", ",", " ", "4."}], "}"}], 
      ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "x", " ", "used", " ", "in", " ", "Add", " ", "and", " ", "also", " ", 
    "directly", " ", "in", " ", "Mul"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sum", " ", "=", " ", 
   RowBox[{
    RowBox[{"TOp", "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{"TCreate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"10.", ",", " ", "10.", ",", " ", "10.", ",", " ", "10."}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"product", " ", "=", " ", 
   RowBox[{
    RowBox[{"TOp", "[", "\"\<Mul\>\"", "]"}], "[", 
    RowBox[{"sum", ",", " ", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{"TINetGraph", "[", 
  RowBox[{"product", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], "Input",Expressi\
onUUID->"3c2829ca-a8eb-431d-8f5d-6f05208ed325"],

Cell["After reduction \[LongDash] graph collapses", "Section",ExpressionUUID->"44aecd11-a8ba-473f-b230-e1086a3ada2f"],

Cell["\<\
Reducing resolves all DUP nodes. The graph collapses to a single materialized \
tensor:\
\>", "Text",ExpressionUUID->"166d3af4-0d18-4c1f-8a97-0148b32275cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"result", " ", "=", " ", 
   RowBox[{"TReduce", "[", "xSquared", "]"}]}], ";"}], "\n", 
 RowBox[{"TINetGraph", "[", "result", "]"}]}], "Input",ExpressionUUID->\
"eaa66a22-01cd-4319-9d06-7acca81bc68b"],

Cell["Interaction Tracing", "Chapter",ExpressionUUID->"985542e7-a27b-4603-92a0-c52b04c3bf8f"],

Cell["\<\
Enable tracing to see which interaction rules fire during reduction. This \
reveals the DUP \[RightTriangle] TEN annihilation when shared tensors resolve:\
\>", "Text",ExpressionUUID->"d7f893cf-8321-412d-9513-e505b7bb10bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5.", ",", " ", "6."}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"expr", " ", "=", " ", 
  RowBox[{
   RowBox[{"TOp", "[", "\"\<Mul\>\"", "]"}], "[", 
   RowBox[{"p", ",", " ", "p"}], "]"}]}]}], "Input",ExpressionUUID->"cd895a39-\
8373-41a4-b292-cede7ef90f5e"],

Cell["\<\
Visualize the lazy graph \[LongDash] note the single DUP node with dp0/dp1 \
edge labels:\
\>", "Text",ExpressionUUID->"aade5024-938c-4dc6-8341-e4e125e70e1d"],

Cell[BoxData[
 RowBox[{"TINetGraph", "[", 
  RowBox[{"expr", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",Expressio\
nUUID->"9186f7ce-68ee-46f9-93f7-dc80dbf5df6c"],

Cell["Reduce with tracing enabled:", "Text",ExpressionUUID->"9830569a-aa2f-478f-8957-ae25ab7a8635"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"TTraceEnable", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TTraceClear", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"result", " ", "=", " ", 
   RowBox[{"TReduce", "[", "expr", "]"}]}], ";"}], "\n", 
 RowBox[{"TTrace", "[", "]"}]}], "Input",ExpressionUUID->"9162d575-cb52-4f04-\
9f89-8338076ffa67"],

Cell["\<\
The trace shows the DUP \[RightTriangle] TEN interaction firing \[LongDash] \
both DP0 and DP1 resolve to the same tensor leaf via the 1-slot cache:\
\>", "Text",ExpressionUUID->"f0353ba6-e1a4-4e69-b76d-d9aba10a7367"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", "result", "]"}], "]"}]], "Input",ExpressionUUID->\
"056f8391-e054-4e4d-9945-53956f837340"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TTraceDisable", "[", "]"}], ";"}]], "Input",ExpressionUUID->"6b7987c3-8b39-46b3-82e7-2a44ebbebf60"],

Cell["Interpreting the trace", "Section",ExpressionUUID->"49879b1f-cceb-4c48-9de7-b15cf5d8ec41"],

Cell["Each trace record has:", "Text",ExpressionUUID->"0ba133f2-1044-4238-a275-149207190f8c"],

Cell[TextData[{
 StyleBox["BeforeTag/BeforeExt",
  FontWeight->Bold],
 ": the node that entered the interaction (e.g., \"Dp0\", \"Top\")"
}], "Item",ExpressionUUID->"58537f90-b9b1-4a99-977a-5342fd548ed6"],

Cell[TextData[{
 StyleBox["AfterTag/AfterExt",
  FontWeight->Bold],
 ": what it reduced to (e.g., \"Ten\", \"Num\")"
}], "Item",ExpressionUUID->"6f768c79-b9ad-4641-9430-6628343117da"],

Cell[TextData[{
 StyleBox["RuleId",
  FontWeight->Bold],
 ": internal rule identifier"
}], "Item",ExpressionUUID->"58ce640e-0644-4cf9-8c3a-230f2456279f"],

Cell["Key DUP interactions:", "Text",ExpressionUUID->"cfa1b04f-3a4d-4416-9d55-f7d9c9939846"],

Cell[TextData[{
 StyleBox["DUP \[RightTriangle] TEN",
  FontWeight->Bold],
 ": Both projections get the same tensor. The 1-slot cache means the value is \
computed once."
}], "Item",ExpressionUUID->"8547f8c6-ccfc-494b-83f7-7af4d10b812a"],

Cell[TextData[{
 StyleBox["DUP \[RightTriangle] SUP (same label)",
  FontWeight->Bold],
 ": Annihilation \[LongDash] the SUP dissolves, each projection takes its \
branch."
}], "Item",ExpressionUUID->"3997bec2-8415-4f69-ae1d-f47b0b739424"],

Cell[TextData[{
 StyleBox["DUP \[RightTriangle] TOP",
  FontWeight->Bold],
 ": Commutation \[LongDash] the DUP pushes through the operation, creating \
DUP'd copies of the op's children."
}], "Item",ExpressionUUID->"9c3f91db-cbdb-485b-8333-53eb5c6442fd"],

Cell["Interaction Net Primitives", "Chapter",ExpressionUUID->"f86bc1d1-edbd-40c0-8bed-f7a75f5f2402"],

Cell[TextData[{
 Cell["TTerm", "InlineCode",ExpressionUUID->
  "976def18-55fc-4ed8-913f-5976fb3731fe"],
 " is for interaction net primitives (lambda, application, superposition, \
duplication). ",
 Cell["TTensor", "InlineCode",ExpressionUUID->
  "8c415838-873b-46b7-8788-a66b5ff1286a"],
 " is for tensor operations. They interoperate via ",
 Cell["ToTTerm", "InlineCode",ExpressionUUID->
  "e515ed26-1a64-4423-b0ab-d96d6587b15c"],
 "/",
 Cell["ToTTensor", "InlineCode",ExpressionUUID->
  "71b61f1e-4b9a-4da1-8216-f65480d06c3a"],
 "."
}], "Text",ExpressionUUID->"cb113cd4-2e74-48e2-92b3-64e0c6c78bcf"],

Cell["Manual DUP/SUP construction", "Section",ExpressionUUID->"02c6e261-29da-4670-8f5f-8f2b46c4a622"],

Cell[TextData[{
 "You can build DUP-SUP pairs directly with ",
 Cell["TDup", "InlineCode",ExpressionUUID->
  "f695495b-7e9b-4e85-9e8d-a69e50984c84"],
 " and ",
 Cell["TSup", "InlineCode",ExpressionUUID->
  "58cc8342-55d9-477d-a423-686adf605cf6"],
 ":"
}], "Text",ExpressionUUID->"441f04e1-c476-40c5-8ef4-4a9d65b1fcbf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", " ", "=", " ", 
   RowBox[{"TCreate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"42.", ",", " ", "99."}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"dp0", ",", " ", "dp1"}], "}"}], " ", "=", " ", 
  RowBox[{"TDup", "[", 
   RowBox[{"ToTTerm", "[", "t", "]"}], "]"}]}]}], "Input",ExpressionUUID->\
"0e66d40f-c103-41cf-a741-5221eeb9d066"],

Cell["Both projections reduce to the same tensor:", "Text",ExpressionUUID->"3147a82c-df92-476b-90be-1edb3a15b09e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"TGet", "[", 
     RowBox[{"TReduce", "[", 
      RowBox[{"ToTTensor", "[", "dp0", "]"}], "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"TGet", "[", 
     RowBox[{"TReduce", "[", 
      RowBox[{"ToTTensor", "[", "dp1", "]"}], "]"}], "]"}], "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"4a0be6b5-1910-49f0-a6f1-8438d5775c0a"],

Cell["Lambda calculus with tensors", "Section",ExpressionUUID->"5c335e2b-5d0a-4ea7-b4dc-aea0f6687f2d"],

Cell[TextData[{
 Cell["TLam", "InlineCode",ExpressionUUID->
  "48a831e3-eb62-46f4-9cbe-039dae498255"],
 " accepts a pure function \[LongDash] the variable is created internally and \
passed to your function for use in the body:"
}], "Text",ExpressionUUID->"9858a7ac-a810-4bad-92f4-0a822b3eda7d"],

Cell[TextData[{
 "Identity function ",
 Cell["(\[Lambda]x. x)", "InlineCode",ExpressionUUID->
  "529d0afb-245b-4bcd-ab08-d63d63a53e7b"],
 " applied to a tensor \[LongDash] \[Beta]-reduction returns the argument:"
}], "Text",ExpressionUUID->"89936a30-7822-468d-a0ba-504e26f1251e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"id", " ", "=", " ", 
   RowBox[{"TLam", "[", 
    RowBox[{"Function", "[", 
     RowBox[{"x", ",", " ", "x"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"app", " ", "=", " ", 
   RowBox[{"TApp", "[", 
    RowBox[{"id", ",", " ", 
     RowBox[{"ToTTerm", "[", 
      RowBox[{"TCreate", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"42.", ",", " ", "99."}], "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", 
   RowBox[{"TReduce", "[", 
    RowBox[{"ToTTensor", "[", "app", "]"}], "]"}], "]"}], "]"}]}], "Input",Exp\
ressionUUID->"25361add-3dc6-41aa-afdf-d1ef883d5efe"],

Cell[TextData[{
 "A function that uses its argument in a computation \[LongDash] ",
 Cell["(\[Lambda]x. x + 10)", "InlineCode",ExpressionUUID->
  "efdcded7-4c52-4fef-b9a9-97a82d39c43a"],
 ":"
}], "Text",ExpressionUUID->"8dee96b2-2c37-407e-91f9-f31f24d0e097"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"addTen", " ", "=", " ", 
   RowBox[{"TLam", "[", 
    RowBox[{"Function", "[", 
     RowBox[{"x", ",", " ", 
      RowBox[{"ToTTerm", "[", 
       RowBox[{
        RowBox[{"TOp", "[", "\"\<Add\>\"", "]"}], "[", 
        RowBox[{
         RowBox[{"ToTTensor", "[", "x", "]"}], ",", " ", 
         RowBox[{"TCreate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"10.", ",", " ", "10."}], "}"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "]"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"app2", " ", "=", " ", 
   RowBox[{"TApp", "[", 
    RowBox[{"addTen", ",", " ", 
     RowBox[{"ToTTerm", "[", 
      RowBox[{"TCreate", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.", ",", " ", "2."}], "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"TGet", "[", 
   RowBox[{"TReduce", "[", 
    RowBox[{"ToTTensor", "[", "app2", "]"}], "]"}], "]"}], "]"}]}], "Input",Ex\
pressionUUID->"ff1d3135-14e8-4fe8-aca0-4019e4180eaf"],

Cell["Visualize inet primitives", "Section",ExpressionUUID->"184db568-6ea8-4ee2-a5a5-ba27edfab296"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"TLam", "[", 
    RowBox[{"Function", "[", 
     RowBox[{"x", ",", " ", "x"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"appViz", " ", "=", " ", 
   RowBox[{"TApp", "[", 
    RowBox[{"f", ",", " ", 
     RowBox[{"ToTTerm", "[", 
      RowBox[{"TCreate", "[", 
       RowBox[{
        RowBox[{"{", "2.", "}"}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TINetGraph", "[", 
  RowBox[{"ToTTensor", "[", "appViz", "]"}], "]"}]}], "Input",ExpressionUUID->\
"158c23cf-dd7b-4696-992a-a9a2ccf7025b"],

Cell["Gradient Backward with DUP", "Chapter",ExpressionUUID->"63119cac-fc32-4c91-9547-756df5086175"],

Cell["\<\
When computing gradients, shared tensors create independent GRAD paths. Each \
path deposits its contribution via accumulative ASSIGN \[LongDash] no \
counters, no special GRAD3_FWD macro. The sharing structure emerges from the \
DUP/SUP pairs created during forward construction.\
\>", "Text",ExpressionUUID->"4df506e3-5124-4ba1-ae6f-02bca13facdf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"x", " ", "used", " ", 
      RowBox[{"twice", ":", " ", "loss"}]}], " ", "=", " ", 
     RowBox[{"x", " ", "*", " ", "x"}]}], ",", " ", 
    RowBox[{
     RowBox[{"so", " ", 
      RowBox[{"dloss", "/", "dx"}]}], " ", "=", " ", 
     RowBox[{"2", "x"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"TCreate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3.", ",", " ", "4."}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"TSetRequiresGrad", "[", "x", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"loss", " ", "=", " ", 
     RowBox[{"TReduce", "[", 
      RowBox[{
       RowBox[{"TOp", "[", "\"\<Mul\>\"", "]"}], "[", 
       RowBox[{"x", ",", " ", "x"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"grad", " ", "=", " ", 
     RowBox[{"TReduce", "[", 
      RowBox[{"TGrad", "[", 
       RowBox[{"loss", ",", " ", "x"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Normal", "[", 
    RowBox[{"TGet", "[", "grad", "]"}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Expected", ":", " ", 
      RowBox[{"{", 
       RowBox[{"6.", ",", " ", "8."}], "}"}]}], " ", "=", " ", 
     RowBox[{"2", " ", "*", " ", 
      RowBox[{"{", 
       RowBox[{"3.", ",", " ", "4."}], "}"}]}]}], " ", "*)"}]}]}]], "Input",Ex\
pressionUUID->"b6112f9d-9464-42de-a633-c2f365c377b8"],

Cell["Cleanup", "Chapter",ExpressionUUID->"1fdf2284-a1d3-409e-a2de-478ff1752150"],

Cell[BoxData[
 RowBox[{"TFree", "[", "]"}]], "Input",ExpressionUUID->"811baef2-5345-4f7e-a499-3489e08aac34"]
