// GRAD ⊳ MUL fires (binary Leibniz).  MUL and the previous GRAD are
// consumed.  Two fresh sub-GRADs appear, one per MUL operand.  The
// incoming cotangent (EXPAND) is DUP'd because both sub-GRADs use it.
// Each sub-GRAD gets MUL(gy, other_operand) as its cotangent.  ADD
// combines the two sub-GRAD outputs into the final result.
// Redex: t1 → GRAD_a (wnf picks the left arm first).
digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  t1     [label="t1\n[3] f32", fillcolor="#ffe0e0"];
  ones   [label="ones\n[1] f32", fillcolor="#e0e0e0"];
  shape3 [label="[3]\nshape", fillcolor="#e0e0e0"];

  EXPAND [label="EXPAND\n[3]", fillcolor="#fff3cd"];
  DUP    [label="", shape=circle, width=0.16, fixedsize=true,
          fillcolor="#d4b8e8", color="#8a63b7"];

  MUL_a  [label="MUL_cot_a\n[3]", fillcolor="#cce5ff"];
  MUL_b  [label="MUL_cot_b\n[3]", fillcolor="#cce5ff"];

  GRAD_a [label="GRAD_a\nd/d(t1)", fillcolor="#e8d0ff"];
  GRAD_b [label="GRAD_b\nd/d(t1)", fillcolor="#e8d0ff"];

  ADD    [label="ADD\n[3]", fillcolor="#cce5ff"];

  ones   -> EXPAND [label="in"];
  shape3 -> EXPAND [label="shape"];
  EXPAND -> DUP    [label=""];
  DUP    -> MUL_a  [label="dp0"];
  DUP    -> MUL_b  [label="dp1"];
  t1     -> MUL_a  [label="b"];
  t1     -> MUL_b  [label="b"];

  t1     -> GRAD_a [label="y", color="#cc0000", penwidth=2];
  MUL_a  -> GRAD_a [label="gy"];
  t1     -> GRAD_a [label="tgt"];

  t1     -> GRAD_b [label="y"];
  MUL_b  -> GRAD_b [label="gy"];
  t1     -> GRAD_b [label="tgt"];

  GRAD_a -> ADD    [label="a"];
  GRAD_b -> ADD    [label="b"];

  out [label="", shape=circle, width=0.12, fixedsize=true, fillcolor="#ffffff"];
  ADD -> out [label="out"];
}
