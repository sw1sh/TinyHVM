// KERNEL_MUL ⊳ KERNEL_SUM just fired.  Two adjacent forward kernels
// merged into KERNEL_fwd (MUL+SUM fused).  Forward is a single kernel
// taking (t1, axes) and producing y.  Now the backward tree starts
// kernelising — first at EXPAND (the only TOP directly adjacent to
// FUSE_b).
// Redex: EXPAND → FUSE_b (first backward TOP).
digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  t1     [label="t1\n[3] f32",   fillcolor="#ffe0e0"];
  axes   [label="axes\n[1] i32", fillcolor="#e0e0e0"];
  shape3 [label="[3]\nshape",    fillcolor="#e0e0e0"];
  ones_a [label="ones_a\n[3]",   fillcolor="#e0e0e0"];
  ones_b [label="ones_b\n[3]",   fillcolor="#e0e0e0"];

  MUL_ca   [label="MUL\n(b·∂a)",       fillcolor="#cce5ff"];
  MUL_cb   [label="MUL\n(a·∂b)",       fillcolor="#cce5ff"];
  ADD_leib [label="ADD\n(Leibniz)",    fillcolor="#cce5ff"];
  EXPAND   [label="EXPAND\n(SUM bwd)", fillcolor="#fff3cd"];

  K_FWD  [label="KERNEL_fwd\n{MUL, SUM}", fillcolor="#8fdd8f"];
  FUSE_b [label="FUSE", fillcolor="#b3e6ff", shape=invhouse];

  y_out [label="y",      shape=circle, width=0.20, fixedsize=true, fillcolor="#ffffff"];
  g_out [label="∂y/∂t1", shape=circle, width=0.30, fixedsize=true, fillcolor="#ffffff"];

  // Forward: single kernel
  t1    -> K_FWD [label="a"];
  t1    -> K_FWD [label="b"];
  axes  -> K_FWD [label="axes"];
  K_FWD -> y_out;

  // Backward (unchanged; EXPAND about to be absorbed by FUSE_b)
  t1     -> MUL_ca [label="b"];
  ones_a -> MUL_ca [label="∂a"];
  t1     -> MUL_cb [label="a"];
  ones_b -> MUL_cb [label="∂b"];
  MUL_ca -> ADD_leib [label="a"];
  MUL_cb -> ADD_leib [label="b"];

  ADD_leib -> EXPAND [label="∂v"];
  shape3   -> EXPAND [label="shape"];
  EXPAND   -> FUSE_b [color="#cc0000", penwidth=2];
  FUSE_b   -> g_out;
}
