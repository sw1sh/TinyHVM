  t4 [label="t4\n[1]\nu32 cpu",shape=box,fillcolor="#e0e0e0"];
  t4 -> n29 [label="arg"];
  n31 [label="APP", shape=invtriangle, fillcolor="#f3f3f3"];
  n29 -> n31 [label="fun"];
  t1 [label="t1\n[3]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
