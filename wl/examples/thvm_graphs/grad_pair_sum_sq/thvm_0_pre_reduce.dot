  grad10 -> n11 [label="fwd"];
  t2 [label="t2\n[1]\ni32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n11 [label="axes",taillabel="@12",labelfontsize=7,fontcolor="#666666"];
  free11_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n11 -> free11_1000 [label="out"];
  era9 [label="ERA\n@9",shape=circle,width=0.38,height=0.38,fixedsize=true,fillcolor="#ffb8b8",fontsize=7];
  h8 [label="h8\ntag=27", shape=box, fillcolor="#dddddd", fontsize=8];
  h8 -> era9 [label="p"];
  n15 [label="EXPAND\n[4]\n@15", shape=box, fillcolor="#fff3cd",color="#1f78ff",penwidth=2.2];
