digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  ctr6 [label="CTR\nN=2", shape=hexagon, fillcolor="#f3f3f3", fontsize=9];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> ctr6 [label="c0"];
  grad3 [label="GRAD\n@3", shape=invtriangle, fillcolor="#e8d0ff"];
  grad3 -> ctr6 [label="c1 (bwd)"];
}
