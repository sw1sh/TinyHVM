digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  t5 [label="t5\n[3]\nf32 cpu\nslot1",shape=box,fillcolor="#e0e0e0",color="#1f78ff",penwidth=2.2];
  n43 [label="KERNEL\nLOAD\nkid=0 cpu\n[3]", shape=box, fillcolor="#ccffcc"];
