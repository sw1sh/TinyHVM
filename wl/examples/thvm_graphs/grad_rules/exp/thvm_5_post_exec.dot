digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  t4 [label="t4\n[3]\nf32 cpu\nslot1",shape=box,fillcolor="#e0e0e0",color="#1f78ff",penwidth=2.2];
  n47 [label="KERNEL\nLOAD\nkid=0 cpu\n[3]", shape=box, fillcolor="#ccffcc"];
  t2 [label="t2\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n47 [style=dashed,color="#009900",fontcolor="#006600",label="EXP:in"];
  t2 -> n47 [style=dashed,color="#009900",fontcolor="#006600",label="MUL:a"];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n47 [style=dashed,color="#009900",fontcolor="#006600",label="EXP:in"];
  n47 -> t4 [style=dashed,color="#009900",fontcolor="#006600",label="MUL:out"];
  rootout_t4 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  t4 -> rootout_t4 [label="out"];
}
