digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n1 [label="RESHAPE\n[1,3]\n@1", shape=box, fillcolor="#fff3cd"];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n1 [label="in",taillabel="@1",labelfontsize=7,fontcolor="#666666"];
  t2 [label="t2\n[2]\ni32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n1 [label="shape",taillabel="@2",labelfontsize=7,fontcolor="#666666"];
  n3 [label="EXPAND\n[4,3]\n@3", shape=box, fillcolor="#fff3cd"];
  n1 -> n3 [label="in"];
  t3 [label="t3\n[2]\ni32 cpu",shape=box,fillcolor="#e0e0e0"];
  t3 -> n3 [label="shape",taillabel="@4",labelfontsize=7,fontcolor="#666666"];
  ctr8 [label="CTR\nN=2", shape=hexagon, fillcolor="#f3f3f3", fontsize=9];
  grad5 [label="GRAD\n@5", shape=invtriangle, fillcolor="#e8d0ff"];
  n3 -> grad5 [label="y",color="#cc0000",penwidth=2.0];
  grad5 -> ctr8 [label="c0 (fwd)"];
  grad5 -> ctr8 [label="c1 (bwd)"];
}
