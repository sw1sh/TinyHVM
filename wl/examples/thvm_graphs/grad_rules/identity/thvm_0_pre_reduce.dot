digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  ctr4 [label="CTR\nN=2", shape=hexagon, fillcolor="#f3f3f3", fontsize=9];
  grad1 [label="GRAD\n@1", shape=invtriangle, fillcolor="#e8d0ff"];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> grad1 [label="y",color="#cc0000",penwidth=2.0];
  grad1 -> ctr4 [label="c0 (fwd)"];
  grad1 -> ctr4 [label="c1 (bwd)"];
}
