digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n40 [label="EXEC\n#0\n@40", shape=box, fillcolor="#ccccff",color="#1f78ff",penwidth=2.2];
  num40_0 [label="0",shape=triangle,fillcolor="#fff2cc",fontsize=8];
  num40_0 -> n40 [label=""];
  free40_1 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  free40_1 -> n40 [label=""];
  free40_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n40 -> free40_1000 [label="out"];
}
