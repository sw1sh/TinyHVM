digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  t3 [label="t3\n[1]\nf32 cpu\nslot1",shape=box,fillcolor="#e0e0e0",color="#1f78ff",penwidth=2.2];
  n26 [label="KERNEL\nLOAD\nkid=0 cpu\n[1]", shape=box, fillcolor="#ccffcc"];
  t2 [label="t2\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n26 [style=dashed,color="#009900",fontcolor="#006600",label="NEG:in"];
  n26 -> t3 [style=dashed,color="#009900",fontcolor="#006600",label="NEG:out"];
  rootout_t3 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  t3 -> rootout_t3 [label="out"];
}
