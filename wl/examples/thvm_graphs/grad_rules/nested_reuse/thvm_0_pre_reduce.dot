digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n2 [label="MUL\n[3]\n@2", shape=box, fillcolor="#cce5ff"];
  dup1 [label="", shape=circle, width=0.12, height=0.12, fixedsize=true, fillcolor="#d4b8e8", color="#8a63b7", fontsize=1];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> dup1[label="",taillabel="@1",labelfontsize=7,fontcolor="#666666"];
  dup1 -> n2 [label="a (dp1@2)"];
  t2 [label="t2\n[3]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n2 [label="b",taillabel="@3",labelfontsize=7,fontcolor="#666666"];
  n4 [label="ADD\n[3]\n@4", shape=box, fillcolor="#cce5ff"];
  dup1 -> n4 [label="a (dp0@4)"];
  n2 -> n4 [label="b"];
  ctr9 [label="CTR\nN=2", shape=hexagon, fillcolor="#f3f3f3", fontsize=9];
  grad6 [label="GRAD\n@6", shape=invtriangle, fillcolor="#e8d0ff"];
  n4 -> grad6 [label="y",color="#cc0000",penwidth=2.0];
  grad6 -> ctr9 [label="c0 (fwd)"];
  grad6 -> ctr9 [label="c1 (bwd)"];
}
