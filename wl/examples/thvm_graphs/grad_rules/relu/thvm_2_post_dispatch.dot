digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n52 [label="KERNEL\nCMP+MUL\nkid=0 cpu\n[4]\n@52", shape=box, fillcolor="#ccffcc",color="#1f78ff",penwidth=2.2];
  t2 [label="t2\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="MUL:a"];
  t1 [label="t1\n[4]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="CMP:a"];
  t3 [label="t3\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t3 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="CMP:b"];
  free52_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n52 -> free52_1000 [label="out"];
  n66 [label="EXPAND\n[4]\n@66", shape=box, fillcolor="#fff3cd"];
  t3 -> n66 [label="in",taillabel="@66",labelfontsize=7,fontcolor="#666666"];
  t4 [label="t4\n[1]\ni32 cpu",shape=box,fillcolor="#e0e0e0"];
  t4 -> n66 [label="shape",taillabel="@67",labelfontsize=7,fontcolor="#666666"];
  n64 [label="EXPAND\n[4]\n@64", shape=box, fillcolor="#fff3cd"];
  t2 -> n64 [label="in",taillabel="@64",labelfontsize=7,fontcolor="#666666"];
  t5 [label="t5\n[1]\ni32 cpu",shape=box,fillcolor="#e0e0e0"];
  t5 -> n64 [label="shape",taillabel="@65",labelfontsize=7,fontcolor="#666666"];
  free64_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n64 -> free64_1000 [label="out"];
  n68 [label="CMP\n[4]\n@68", shape=box, fillcolor="#cce5ff"];
  t1 -> n68 [label="a",taillabel="@68",labelfontsize=7,fontcolor="#666666"];
  n66 -> n68 [label="b"];
  free68_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n68 -> free68_1000 [label="out"];
}
