digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n48 [label="KERNEL\nCMP+MUL\nkid=0 cpu\n[4]\n@48", shape=box, fillcolor="#ccffcc",color="#1f78ff",penwidth=2.2];
  t2 [label="t2\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n48 [style=dashed,color="#009900",fontcolor="#006600",label="MUL:a"];
  t1 [label="t1\n[4]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n48 [style=dashed,color="#009900",fontcolor="#006600",label="CMP:a"];
  t3 [label="t3\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t3 -> n48 [style=dashed,color="#009900",fontcolor="#006600",label="CMP:b"];
  free48_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n48 -> free48_1000 [label="out"];
  n64 [label="CMP\n[4]\n@64", shape=box, fillcolor="#cce5ff"];
  t1 -> n64 [label="a",taillabel="@64",labelfontsize=7,fontcolor="#666666"];
  n62 -> n64 [label="b"];
  free64_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n64 -> free64_1000 [label="out"];
}
