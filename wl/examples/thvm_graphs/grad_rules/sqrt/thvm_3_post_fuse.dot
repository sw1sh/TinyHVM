digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n52 [label="KERNEL\nSQRT+MUL+DIV\nkid=0 cpu\n[3]\n@52", shape=box, fillcolor="#ccffcc",color="#1f78ff",penwidth=2.2];
  t2 [label="t2\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="SQRT:in"];
  t2 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="DIV:a"];
  t3 [label="t3\n[1]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
  t3 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="MUL:a"];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n52 [style=dashed,color="#009900",fontcolor="#006600",label="SQRT:in"];
  free52_1000 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n52 -> free52_1000 [label="out"];
}
