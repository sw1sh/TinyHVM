digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n124 [label="GRAD\nd/d(t1)\n@124", shape=box, fillcolor="#e8d0ff"];
  dup121 [label="", shape=circle, width=0.12, height=0.12, fixedsize=true, fillcolor="#d4b8e8", color="#8a63b7", fontsize=1];
  n122 -> dup121;
  dup121 -> n124 [label="y (dp1@124)"];
  free124_1 [label="",shape=circle,width=0.14,height=0.14,fixedsize=true,fillcolor="#ffffff",color="#888888",fontsize=1];
  n124 -> free124_1 [label="gy"];
  n122 [label="SUB\n[3]\n@122", shape=box, fillcolor="#cce5ff"];
  t1 [label="t1\n[3]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n122 [label="a",taillabel="@122",labelfontsize=7,fontcolor="#666666"];
  t2 [label="t2\n[3]\nf32 cpu",shape=box,fillcolor="#e0e0e0"];
