digraph G {
  rankdir=BT;
  node [fontname="Helvetica", fontsize=10, style=filled, shape=box, margin="0.1,0.05"];
  edge [fontsize=8, fontname="Helvetica"];

  n10 [label="SUM\n[1]\n@10", shape=box, fillcolor="#ffcccc"];
  t1 [label="t1\n[4]\nf32 cpu grad",shape=box,fillcolor="#ffe0e0"];
  t1 -> n10 [label="in",taillabel="@10",labelfontsize=7,fontcolor="#666666"];
  t2 [label="t2\n[1]\ni32 cpu",shape=box,fillcolor="#e0e0e0"];
  t2 -> n10 [label="axes",taillabel="@11",labelfontsize=7,fontcolor="#666666"];
  ctr6 [label="CTR\nN=2", shape=hexagon, fillcolor="#f3f3f3", fontsize=9];
  n10 -> ctr6 [label="c0"];
  grad3 [label="GRAD\n@3", shape=invtriangle, fillcolor="#e8d0ff"];
  grad3 -> ctr6 [label="c1 (bwd)"];
}
